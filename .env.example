# Multi-Feed deployment secrets
# Copy this to .env and fill in your values.

# Required: NEAR private key for deploying contracts.
NEAR_PRIVATE_KEY=ed25519:...

# Required: NEAR price reporter account (the account that owns the reporter key).
NEAR_PRICE_REPORTER_ACCOUNT=reporter.near

# Required: NEAR private key for submitting price feed data.
NEAR_PRICE_REPORTER_PRIVATE_KEY=ed25519:...

# Required: NEAR RPC endpoint.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com